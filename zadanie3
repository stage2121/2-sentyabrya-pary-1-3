class Car:
    def __init__(self):
        self.engine_temperature = 20
    
    def start_engine(self):
        self.engine_temperature = 90
        print("Двигатель прогрет")
    
    def drive(self):
        if self.engine_temperature >= 90:
            print("Поехали!")
        else:
            print("Двигатель не прогрет! Запустите двигатель.")

my_car = Car()

print(f"Прямой доступ к _engine_temperature: {my_car.engine_temperature}°C")

print("\nПопытка поехать без прогрева:")
my_car.drive()

print("\nЗапуск двигателя:")
my_car.start_engine()

print("\nПопытка поехать после прогрева:")
my_car.drive()

print(f"\nТемпература двигателя после прогрева: {my_car.engine_temperature}°C")